{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thephotogame",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "thephotogame",
			// Fill in after `npx wrangler d1 create thephotogame`.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "thephotogame-photos" }],
	"vars": {
		// This email becomes the site admin once it's confirmed (by email code or invite).
		// If empty, the first person to confirm an email while there's no site admin becomes it.
		"ADMIN_EMAIL": "",
		// Used for grouping photos by day.
		"TIME_ZONE": "America/New_York",
		// The sender for codes and invites: an address on a domain verified in Resend.
		"MAIL_FROM": "The Photo Game <photogame@example.com>",
		// Cloudflare Turnstile site key (public). With TURNSTILE_SECRET set too, new accounts need the bot check.
		"TURNSTILE_SITE_KEY": ""
	}
	// Secrets (not here), set with `npx wrangler secret put <NAME>`:
	//   RESEND_API_KEY    without it, sign-in codes and invites are printed to the log.
	//   TURNSTILE_SECRET  the Turnstile widget's secret key.
}
