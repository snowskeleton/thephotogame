# Public URL of the site, exactly as people open it (needed for sign-in and passkeys).
ORIGIN=https://photos.example.com

# The account with this email becomes an admin when it first joins or signs in.
# If empty, the very first account created is the admin.
ADMIN_EMAIL=you@example.com

# Outgoing mail for sign-in codes. Without SMTP_HOST, codes are printed to the container log.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=The Photo Game <photogame@example.com>

# Used for grouping photos by day.
TZ=America/New_York
